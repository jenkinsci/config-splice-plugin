<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2211.v27f680c93c53</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>config-splice</artifactId>
  <!-- Resolved by the git-changelist extension in .mvn/; see the changelist property below. -->
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>Config Splice</name>
  <!-- No <description> here on purpose: the maven-hpi-plugin requires the plugin description to live
       in src/main/resources/index.jelly and refuses to package if both are present. -->
  <url>https://github.com/jenkinsci/config-splice-plugin</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- Maintainer information is deliberately absent: it is fetched from
       jenkins-infra/repository-permissions-updater and shown on the update site, and the hosting
       checker rejects a developer section declared here. -->

  <scm>
    <connection>scm:git:https://github.com/jenkinsci/config-splice-plugin.git</connection>
    <developerConnection>scm:git:git@github.com:jenkinsci/config-splice-plugin.git</developerConnection>
    <url>https://github.com/jenkinsci/config-splice-plugin</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- Placeholder version for local and pull-request builds. The CD workflow replaces it with a
         real version derived from the git history; see .mvn/maven.config. -->
    <changelist>999999-SNAPSHOT</changelist>

    <!-- SRS 14.1: minimum core 2.541.3. The baseline is a property so that the core version and the
         plugin BOM below can never drift apart. The Java release level comes from the parent POM,
         which derives it from this baseline. -->
    <jenkins.baseline>2.541</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>

    <gitHubRepo>jenkinsci/config-splice-plugin</gitHubRepo>

    <!-- Fail the build if a third-party library would be bundled into the HPI by accident. -->
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>

    <!-- Enforcement rules the parent POM ships but leaves opt-in. All are enabled deliberately:
         each one catches a class of mistake that is cheap to prevent and awkward to unpick later. -->
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
  </properties>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <!-- SRS 14.2: plugin versions come from the BOM matching the chosen baseline. -->
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>6783.v88c6c30f4b_db_</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Versions intentionally omitted: supplied by the BOM above (SRS 14.2). -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-step-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>plain-credentials</artifactId>
    </dependency>
    <!-- SRS 14.2: JSON comes through jackson2-api, never a direct com.fasterxml.jackson dependency. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>jackson2-api</artifactId>
    </dependency>

    <!-- Test only: gate 5 runs a real sandboxed Pipeline to prove the result map needs no
         Script Approval. These are not runtime dependencies of the step itself. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-job</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- StepConfigTester renders the real config.jelly and re-binds the submitted form, which is the
         only way to prove the form actually binds rather than merely parsing. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-step-api</artifactId>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-basic-steps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-durable-task-step</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Folders exist only so the credential test can prove folder-scoped resolution works
         (SRS 12.1); the plugin itself has no folder dependency. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>cloudbees-folder</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
